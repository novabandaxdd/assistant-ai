{
  "compilerOptions": {
    "composite":                true,
    "target":                   "ESNext",
    "module":                   "ESNext",
    "moduleResolution":         "bundler",
    "lib":                      ["ESNext"],
    "skipLibCheck":             true,
    "allowSyntheticDefaultImports": true,
    "strict":                   true,
    "outDir":                   "dist-electron",
    "declaration":              true,
    "declarationMap":           true
  },
  "include": ["electron"]
}
