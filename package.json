{
  "name": "jarvis-brain",
  "productName": "JARVIS Brain",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "AI-powered Project Intelligence Hub",
  "author": "Raul Sousa",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "electron:dev": "BUILD_TARGET=electron vite",
    "electron:build": "BUILD_TARGET=electron tsc && BUILD_TARGET=electron vite build",
    "dist": "npm run electron:build && electron-builder",
    "dist:win": "npm run electron:build && electron-builder --win",
    "dist:linux": "npm run electron:build && electron-builder --linux",
    "dist:mac": "npm run electron:build && electron-builder --mac"
  },
  "build": {
    "appId": "com.jarvis.brain",
    "productName": "JARVIS Brain",
    "copyright": "© 2025 Raul Sousa",
    "directories": {
      "buildResources": "build-resources",
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "extraResources": [],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build-resources/icon.ico",
      "signingHashAlgorithms": null,
      "sign": null
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "JARVIS Brain"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build-resources/icon.png",
      "category": "Utility"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build-resources/icon.icns",
      "category": "public.app-category.productivity"
    },
    "dmg": {
      "title": "${productName} ${version}",
      "background": "build-resources/dmg-background.png"
    }
  },
  "dependencies": {
    "framer-motion": "^11.3.8",
    "idb": "^8.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-force-graph-2d": "^1.29.1",
    "react-force-graph-3d": "^1.24.3",
    "three": "^0.167.0",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.167.0",
    "@vercel/node": "^6.0.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^32.3.3",
    "electron-builder": "^24.13.3",
    "sharp": "^0.35.3",
    "typescript": "^5.5.3",
    "vite": "^5.3.4",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  }
}
